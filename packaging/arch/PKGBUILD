# Maintainer: Daaboulex <https://github.com/Daaboulex>

pkgname=vkbasalt-overlay-wayland-git
pkgver=r1.0000000
pkgrel=1
pkgdesc="Vulkan post-processing layer with an in-game overlay, on Wayland and X11"
arch=('x86_64')
url="https://github.com/Daaboulex/vkBasalt_overlay_wayland"
license=('zlib')
depends=('gcc-libs' 'glslang' 'libx11' 'libxi' 'wayland' 'libxkbcommon' 'vulkan-icd-loader')
makedepends=('git' 'meson' 'ninja' 'pkgconf' 'spirv-headers' 'vulkan-headers' 'wayland-protocols')
# Both layers read ENABLE_VKBASALT, so installing both activates both: effects
# apply twice and neither can be disabled without the other. The layer warns
# when it detects the other in the same process; this stops it happening at all.
provides=('vkbasalt')
conflicts=('vkbasalt' 'vkbasalt-git' 'vkbasalt-overlay-git')
source=("$pkgname::git+https://github.com/Daaboulex/vkBasalt_overlay_wayland.git")
sha256sums=('SKIP')

pkgver() {
    cd "$srcdir/$pkgname"
    printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
    cd "$srcdir/$pkgname"
    arch-meson build --buildtype=release
    ninja -C build
}

package() {
    cd "$srcdir/$pkgname"
    DESTDIR="$pkgdir" ninja -C build install

    # meson does not install the launcher: it carries an @out@ placeholder for
    # the audit library, which each packaging resolves to its own prefix. Without
    # it there is no LD_AUDIT, and input blocking silently cannot work under
    # wine on Wayland.
    sed 's|@out@|/usr|g' vkbasalt-run.sh > "$srcdir/vkbasalt-run"
    install -Dm755 "$srcdir/vkbasalt-run" "$pkgdir/usr/bin/vkbasalt-run"

    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 SHADER-COMPATIBILITY.md "$pkgdir/usr/share/doc/$pkgname/SHADER-COMPATIBILITY.md"
}
